# Signet: free coins (e.g. https://signetfaucet.com), ~10 minute blocks. Copy to docker/signet.env.
NETWORK=signet
MEMPOOL_API=https://mempool.space/signet/api
# Blocks: leave empty to read them from mempool.space. To use GetBlock instead, set
# BITCOIN_RPC=http://btc-proxy plus a signet GETBLOCK_HOST and GETBLOCK_TOKEN.
BITCOIN_RPC=
GETBLOCK_HOST=
GETBLOCK_TOKEN=
# From the launch (docs/REMOTE.md)
RULES_INSCRIPTION_ID=
RULES_BLOCK=
START_HEIGHT=
PARENT_OUTPOINT=
SECRETS_DIR=./secrets/signet
LAUNCH_DIR=./launch/signet
PUBLIC_PLATFORM_URL=http://localhost:5030
BATCH_MS=120000

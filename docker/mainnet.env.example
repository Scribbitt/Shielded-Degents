# Mainnet: real BTC. Copy to docker/mainnet.env (gitignored) and read docs/LAUNCH.md first.
NETWORK=mainnet
MEMPOOL_API=https://mempool.space/api
# Blocks from GetBlock through btc-proxy (same token as xcp-api-mime works)
BITCOIN_RPC=http://btc-proxy
GETBLOCK_HOST=shared.eu-central-1.getblock.io
GETBLOCK_TOKEN=
RULES_INSCRIPTION_ID=
RULES_BLOCK=
START_HEIGHT=
PARENT_OUTPOINT=
SPEND_VKEY=zk/ceremony/spend/vkey.json
SECRETS_DIR=./secrets/mainnet
LAUNCH_DIR=./launch/mainnet
PUBLIC_PLATFORM_URL=http://localhost:5030
